 static int is_full_screen;
+/* 0 follows the stream DAR, 3 uses aspect-preserving fullscreen zoom. */
+static int display_aspect_mode;

static void check_aspect_request(VideoState *is)
{
    if (access("/tmp/pocketstremio-aspect-request", F_OK) == 0) {
        unlink("/tmp/pocketstremio-aspect-request");
        display_aspect_mode = display_aspect_mode == 3 ? 0 : 3;
        is->force_refresh = 1;
    }
}
