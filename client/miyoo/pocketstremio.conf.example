# Copy this file to config/pocketstremio.conf on the Miyoo.
# Environment variables still take precedence over these values.
# Required PocketStremio server URL, using a LAN or overlay-network address.
SERVER_BASE=
# Leave empty for direct LAN or other system-provided connectivity.
PROXY=
DEFAULT_QUERY=big buck bunny
AUTO_FIRST=0
# App-local decoded-audio gain for normal Onion FFplay playback (1 to 2).
# 2.0 is +6 dB and may clip unusually loud sources.
AUDIO_GAIN=2.0
