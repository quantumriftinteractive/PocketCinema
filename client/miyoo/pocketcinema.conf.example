# Copy this file to config/pocketcinema.conf on the Miyoo.
# Environment variables still take precedence over these values.
# Legacy single PCServer URL. Existing configurations remain supported unchanged.
SERVER_BASE=
# Leave empty for direct LAN or other system-provided connectivity. Settings can
# restore the supported generic HTTP-proxy default.
PROXY=
# New connection profile. Leave all three endpoint/mode fields empty to retain
# legacy SERVER_BASE behavior. Automatic tries Local directly, then Remote
# through PROXY. Remote setup requires a separately configured generic proxy.
LOCAL_PCSERVER=
REMOTE_PCSERVER=
CONNECTION_MODE=
DEFAULT_QUERY=big buck bunny
AUTO_FIRST=0
# App-local decoded-audio gain for normal Onion FFplay playback (1 to 2).
# 2.0 is +6 dB and may clip unusually loud sources.
AUDIO_GAIN=2.0
# Optional ordered language codes stored by the Settings language-name picker.
# Leave empty to keep the existing per-playback picker. Custom 2- or 3-letter
# source codes can also be entered through the Advanced settings option. Audio
# fallback is ask, first, or stop. Subtitle fallback is ask or none.
AUDIO_LANGUAGES=
AUDIO_FALLBACK=ask
SUBTITLE_LANGUAGES=
SUBTITLE_FALLBACK=ask
# App-local selectable-subtitle font scale. Supported values: 1.0, 1.25,
# 1.5, 2.0, 2.5, 3.0. The default is 1.5.
SUBTITLE_FONT_SCALE=1.5
# Selectable app-local Matroska subtitle tracks. PCServer selects up to this many
# tracks per preferred language (bounded to 3); use
# R1 during playback to cycle them and off. Setup failure returns to the normal
# subtitle selector and unchanged MPEG-TS burn-in path.
MAX_SUBTITLES_PER_LANGUAGE=3
# Enabled by default. Set to 0 only to opt out and use the normal subtitle
# selection / MPEG-TS burn-in path instead.
POCKETCINEMA_MATROSKA_SUBTITLES=1
